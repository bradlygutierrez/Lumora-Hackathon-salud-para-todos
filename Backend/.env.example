APP_NAME=Lumora API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
JWT_SECRET=generate-a-random-secret-with-at-least-32-bytes
JWT_ALGORITHM=HS256
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
RECOVERY_TOKEN_MINUTES=30
EMAIL_VERIFICATION_HOURS=24
VERIFICATION_CODE_MINUTES=15
VERIFICATION_RESEND_SECONDS=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
EMAIL_FROM=
MFA_CHALLENGE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_RECOVERY_CODES=10
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://127.0.0.1:4173"]
PROFILE_IMAGE_DIR=storage/profile-images
PROFILE_IMAGE_BASE_URL=/media/profile-images
# I04 -- "local" (default, para desarrollo), "r2" (Cloudflare R2) o "b2"
# (Backblaze B2 -- no exige tarjeta para el free tier). Si es "r2", las 5
# variables R2_* de abajo son obligatorias; si es "b2", las 5 variables
# B2_* son obligatorias -- nunca poner las credenciales reales en este
# archivo, van solo en el secret manager del hosting.
PROFILE_IMAGE_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_REGION=
B2_PUBLIC_BASE_URL=
# I03 -- clave de API maestra fija, opcional. Vacía = deshabilitada (solo
# funcionan las claves emitidas por /clientes-api). Si se define, cualquier
# request con "X-API-Key: <este valor>" identifica al cliente sin pasar por
# la tabla de clientes/claves. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# y cargarla solo por variable de entorno/secret manager del hosting --
# nunca committear un valor real acá.
API_MASTER_KEY=

# Credenciales QA sintéticas. Copiar a .env.e2e.local; ese archivo está ignorado por Git.
LUMORA_E2E_LOGIN=
LUMORA_E2E_PASSWORD=

# Solo si la cuenta requiere MFA. Para TOTP se prefiere el secreto Base32.
LUMORA_E2E_TOTP_SECRET=

# Alternativa para Email OTP/TOTP: código actual de 6 dígitos.
# No lo commitees; actualízalo justo antes de correr el E2E si lo necesitás.
LUMORA_E2E_MFA_CODE=

# Opcional. El runner inicia Expo web en 127.0.0.1:4173 por defecto.
LUMORA_E2E_BASE_URL=http://127.0.0.1:4173
